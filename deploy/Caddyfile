# Reverse proxy TLS para AdrithStore, usando el nombre de Tailscale
# (desktop-6m5le6v.tail7a9fbb.ts.net) en vez de un dominio publico.
#
# Tailscale ya emite un certificado real (Let's Encrypt) para este nombre sin
# exponer nada a internet publico. Caddy NO lo puede pedir solo via ACME HTTP
# normal (la maquina no es alcanzable desde afuera) - hay que generarlo con
# "tailscale cert" y pasarselo a Caddy explicito.
#
# En la maquina cliente (Windows), correr UNA vez (y despues cada ~90 dias,
# Tailscale avisa cuando falta renovar):
#   tailscale cert desktop-6m5le6v.tail7a9fbb.ts.net
# Esto genera, en el directorio donde lo corras:
#   desktop-6m5le6v.tail7a9fbb.ts.net.crt
#   desktop-6m5le6v.tail7a9fbb.ts.net.key
# Mover ambos a C:\adrithstore\tls\ (o ajustar las rutas de abajo).
#
# Instalacion de Caddy en Windows: https://caddyserver.com/docs/install
# (bajar el .exe, ponerlo en C:\caddy\caddy.exe). Este archivo va en
# C:\adrithstore\Caddyfile y se corre con: caddy run --config C:\adrithstore\Caddyfile
#
# El backend Spring Boot NUNCA se expone directo (escucha solo en
# 127.0.0.1:8080, ver application-prod.properties) - todo el trafico entra
# por aca, en el puerto 443, solo alcanzable desde dispositivos en la misma
# tailnet.

desktop-6m5le6v.tail7a9fbb.ts.net {
    tls C:/adrithstore/tls/desktop-6m5le6v.tail7a9fbb.ts.net.crt C:/adrithstore/tls/desktop-6m5le6v.tail7a9fbb.ts.net.key

    encode gzip

    # API: todo /api/** va al backend, que solo escucha en localhost.
    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    # Frontend: archivos estaticos generados por "npm run build" (FRONTEND/dist).
    # try_files sirve index.html para rutas de React Router (SPA).
    handle {
        root * C:/adrithstore/app/FRONTEND/dist
        file_server
        try_files {path} /index.html
    }
}

# Si en el futuro consiguen un dominio publico real, reemplazar el bloque de
# arriba por uno con ese dominio y sacar la linea "tls ..." - Caddy va a pedir
# el certificado Let's Encrypt solo, de forma automatica.
