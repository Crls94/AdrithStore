# Reverse proxy TLS para AdrithStore - alternativa a Caddy (deploy/Caddyfile).
# Mas manual: hay que correr certbot vos mismo para el certificado y su
# renovacion (Caddy lo hace solo). Usar esto si el equipo ya tiene experiencia
# con nginx/certbot o si la maquina cliente ya corre nginx para otra cosa.
#
# Pasos (Ubuntu/Debian):
#   sudo apt install nginx certbot python3-certbot-nginx
#   sudo cp nginx.conf.example /etc/nginx/sites-available/adrithstore
#   sudo ln -s /etc/nginx/sites-available/adrithstore /etc/nginx/sites-enabled/
#   # ajustar server_name y la ruta de "root" abajo primero
#   sudo certbot --nginx -d midominio.com   # obtiene el cert y reescribe este bloque a HTTPS
#   sudo systemctl reload nginx
#
# El backend Spring Boot solo escucha en 127.0.0.1:8080 (ver
# application-prod.properties) - nunca expuesto directo a la red.

server {
    listen 80;
    listen [::]:80;
    server_name midominio.com;

    # certbot --nginx agrega automaticamente el bloque de redireccion a HTTPS
    # y el server{} de abajo con listen 443 ssl + las rutas de los certificados.
    # Dejamos el resto de la config (proxy /api, static frontend) ya lista acá
    # para que certbot solo tenga que insertar las lineas de TLS.

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    root /opt/adrithstore/app/FRONTEND/dist;
    index index.html;

    # SPA: cualquier ruta que no sea un archivo real cae en index.html
    # (React Router maneja el resto client-side).
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# --------------------------------------------------------------------------
# Si todavia no hay dominio propio: usar un certificado autofirmado temporal
# en vez de todo el bloque de arriba (reemplazar por Let's Encrypt/certbot en
# cuanto haya un dominio apuntando a esta maquina):
#
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout /etc/ssl/private/adrithstore-selfsigned.key \
#     -out /etc/ssl/certs/adrithstore-selfsigned.crt
#
# server {
#     listen 443 ssl;
#     server_name _;
#     ssl_certificate     /etc/ssl/certs/adrithstore-selfsigned.crt;
#     ssl_certificate_key /etc/ssl/private/adrithstore-selfsigned.key;
#     location /api/ { proxy_pass http://127.0.0.1:8080; ... }
#     root /opt/adrithstore/app/FRONTEND/dist;
#     location / { try_files $uri $uri/ /index.html; }
# }
