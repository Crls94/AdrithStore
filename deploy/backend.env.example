# Variables de entorno requeridas para correr el backend en produccion
# (perfil "prod"). Copiar este archivo a /etc/adrithstore/backend.env en la
# maquina cliente, completar los valores reales, y NUNCA commitear ese
# archivo con valores reales a git (ya viene en .gitignore como *.env, pero
# igual: si vas a copiarlo dentro del repo por comodidad, cuidado).
#
# El systemd unit (deploy/adrithstore-backend.service) carga este archivo via
# EnvironmentFile= y arranca el jar con --spring.profiles.active=prod, que
# activa application-prod.properties (BACKEND/src/main/resources), donde
# estas variables se referencian.

# Conexion a PostgreSQL. Si Postgres corre en la misma maquina (lo normal en
# este tipo de despliegue), el host es localhost.
DB_URL=jdbc:postgresql://localhost:5432/AdrithStore
DB_USER=postgres
DB_PASSWORD=CAMBIAR_por_una_contrasena_real_y_distinta_a_la_de_desarrollo

# Secreto para firmar los JWT de sesion. Generar uno propio y unico por
# instalacion, NUNCA reusar el de desarrollo. Ejemplo para generar uno:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio_generado_con_openssl

# Minutos de expiracion del JWT (opcional, default 600 = 10 horas si se omite).
JWT_EXPIRATION_MINUTES=600

# URL publica real del frontend (la que ve el navegador, detras del proxy TLS
# de deploy/Caddyfile) - usada para la allowlist de CORS. Sin "/" al final.
# Si se necesita mas de un origen, separar por coma.
APP_FRONTEND_URL=https://desktop-6m5le6v.tail7a9fbb.ts.net
